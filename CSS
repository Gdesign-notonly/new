body{
  background-image: url(https://images.unsplash.com/photo-1530982011887-3cc11cc85693?q=80&w=2064&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D);
  background-size: 1920px 1080px;
}


h1{
  text-align:center;
  font-size: 70px;
  color:white;
}
h2{
  font-size:50px;
  color:#FB8159;
  
  
}
.container1{
      display: grid;
    grid-template-columns:repeat(3,0fr);
  grid-gap: 40px;
  font-size: 18px;
  font-family: monospace;
  justify-content: center;
}

a{
  color: #FB8159;
  margin: 5px 5px;
    font-family:cursive;
font-size:18px;
}

.card1{
  text-align:center;
  
  height:400px;
  width:400px;
  border-radius:20px;
  background-color:white;
}

p{
  margin:20px;
  font-size: 16px;
}



footer{
  text-align:center;
  color:white;
  font-family:serif;
  margin: 40px;

}
.lastlink{

  color:white;
  font-family: serif;
}

@media (max-width: 768px){
  .container1{
    grid-template-columns: 1fr; /* одна карточка */
    gap: 24px;
    padding: 0 16px;
  }
  .card1{
    width: 100%;

}
